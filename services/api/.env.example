# AL-BAHR HORIZON OS API — Example Environment Variables (DO NOT COMMIT REAL .env)
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
OS_DB_PATH=./horizon_os_dev.sqlite
# Generate strong 32+ byte random secrets in production secret manager:
OS_JWT_SECRET=replace-with-32-byte-random-secret-in-production
OS_SIGNED_URL_SECRET=replace-with-different-32-byte-random-secret
# Set to 1 ONLY in local dev/QA to seed synthetic non-production CEO account:
OS_DEV_SEED=0
